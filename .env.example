# ==========================================
# APP CONFIG
# ==========================================
APP_NAME=orchestrator-service
APP_VERSION=1.2.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==========================================
# DATABASE CONFIG (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql+asyncpg://postgresuser:postgrespsw@127.0.0.1:5432/orchestrator_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=False

# ==========================================
# EXTERNAL APIs CONFIG
# ==========================================
# Media API (Imágenes)
MEDIA_API_URL=http://localhost:8006
MEDIA_API_KEY=tu_media_api_key_aqui

# Nubosity API (Clima)
NUBOSITY_API_URL=http://localhost:8002

# Vegetation API (Vegetación)
VEGETATION_API_URL=http://localhost:8003

# Telemetry API (IoT)
TELEMETRY_API_URL=http://localhost:8004
TELEMETRY_API_KEY=api-b-secret-key-change-me

# Risk Fire API (Predicción)
RISK_FIRE_API_URL=http://localhost:8005
RISK_FIRE_API_KEY=tu_risk_fire_api_key_aqui

# ==========================================
# HTTP CLIENT CONFIG
# ==========================================
HTTP_TIMEOUT_CONNECT=5.0
HTTP_TIMEOUT_READ=30.0
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF=0.5

# ==========================================
# CACHE CONFIG
# ==========================================
RULE_CACHE_TTL_SECONDS=300
RULE_CACHE_MAX_SIZE=100